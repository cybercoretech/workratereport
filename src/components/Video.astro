---
// Click-to-load YouTube facade: only the thumbnail (i.ytimg.com) loads until
// clicked; the player then loads from youtube-nocookie.com. Official uploads only (BLUEPRINT §9).
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<div class="video" data-yt={id}>
  <button type="button" style={`--thumb:url(https://i.ytimg.com/vi/${id}/hqdefault.jpg)`} aria-label={`Play video: ${title}`}></button>
</div>
<script is:inline>
  document.querySelectorAll('.video[data-yt] button').forEach((b) => b.addEventListener('click', () => {
    const box = b.parentElement, f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
    f.title = b.getAttribute('aria-label').replace('Play video: ', '');
    f.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
    f.allowFullscreen = true; box.replaceChildren(f);
  }, { once: true }));
</script>
