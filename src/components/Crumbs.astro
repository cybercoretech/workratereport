---
interface Props { trail: [string, string?][] }
const { trail } = Astro.props;
---
<nav class="crumbs wrap" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {trail.map(([label, href], i) => (
      <li>{href && i < trail.length - 1 ? <a href={href}>{label}</a> : <span aria-current="page">{label}</span>}</li>
    ))}
  </ol>
</nav>
