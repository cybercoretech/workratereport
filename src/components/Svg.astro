---
// Inlines a theme-following brand SVG (generated by brand/tools/themeable.py).
import logo from './brand/logo-horizontal.svg?raw';
import emblem from './brand/emblem.svg?raw';
import ropes from './brand/divider-ropes.svg?raw';
const FILES = { logo, emblem, ropes } as const;
interface Props { name: keyof typeof FILES; label?: string; class?: string }
const { name, label, class: cls } = Astro.props;
const svg = FILES[name]
  .replace(/\s(role|aria-label)="[^"]*"/g, '')
  .replace('<svg ', `<svg ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"'} focusable="false" `);
---
<span class={cls} set:html={svg} />
