---
import { getCollection, getEntries } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import WrestlerCard from '../../../components/WrestlerCard.astro';
import SectionHead from '../../../components/SectionHead.astro';
import MatchGrid from '../../../components/MatchGrid.astro';
import { matches } from '../../../lib/site';
export async function getStaticPaths() {
  return (await getCollection('factions')).map((f) => ({ params: { slug: f.id }, props: { f } }));
}
const { f } = Astro.props;
const members = (await getCollection('wrestlers')).filter((w) => w.data.factions.some((x) => x.id === f.id));
const promos = await getEntries(f.data.promotions);
const all = await matches();
const list = all.filter((m) => m.data.wrestlers.some((w) => members.some((x) => x.id === w.id)));
const count = (id: string) => all.filter((m) => m.data.wrestlers.some((w) => w.id === id)).length;
---
<Base title={f.data.name} section="/wrestlers/" vault search="Faction">
  <Crumbs trail={[['Wrestlers', '/wrestlers/'], ['Factions', '/wrestlers/factions/'], [f.data.name]]} />
  <section class="hero vault-hero"><div class="hero-glow" aria-hidden="true"></div><div class="wrap">
    <p class="eyebrow">{promos.map((p) => p.data.short).join(' · ')} · {f.data.years}</p>
    <h1>{f.data.name}</h1><p class="lede">{f.data.summary}</p>
  </div></section>
  <section class="section wrap"><SectionHead eyebrow="Members" title="On the site" /><div class="grid">{members.map((w) => <WrestlerCard w={w} count={count(w.id)} />)}</div></section>
  <section class="section wrap"><SectionHead eyebrow="Matches" title="Featuring members" /><MatchGrid list={list} /></section>
</Base>
