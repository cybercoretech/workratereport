---
import { getCollection, getEntries } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import { matches } from '../../../lib/site';
import { feudMatches } from '../../../lib/vault';
const all = await matches();
const feuds = await Promise.all((await getCollection('feuds')).map(async (f) => ({ f, sides: await getEntries(f.data.sides), n: feudMatches(f, all).length })));
---
<Base title="Feuds" section="/vault/" vault>
  <Crumbs trail={[['Classic Vault', '/vault/'], ['Feuds']]} />
  <section class="section wrap">
    <p class="eyebrow">Classic Vault</p><h1>The great feuds</h1>
    <p class="lede">The rivalries that drew the houses, with every match on the site in order.</p>
    <div class="grid wide">{feuds.map(({ f, sides, n }) => <a class="card reveal" href={`/vault/feuds/${f.id}/`}><div class="card-meta"><span class="promo">{f.data.years}</span></div><h3>{f.data.name}</h3><p class="event">{sides.map((s) => s.data.name).join(' vs. ')}</p><p class="summary">{f.data.summary}</p><div class="card-foot"><span class="rating-who">{n} {n === 1 ? 'match' : 'matches'} logged</span></div></a>)}</div>
  </section>
</Base>
