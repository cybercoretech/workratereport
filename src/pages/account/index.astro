---
// Member account: Google sign-in, then the profile editor.
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
const v = createHash('sha256').update(readFileSync('public/js/account.js')).digest('hex').slice(0, 10);
const avatars = ['belt', 'mask', 'bell', 'mic', 'chair', 'ropes', 'boots', 'turnbuckle'];
const labels: Record<string, string> = { belt: 'Title belt', mask: 'Luchador mask', bell: 'Ring bell', mic: 'Microphone', chair: 'Steel chair', ropes: 'Ring ropes', boots: 'Boots', turnbuckle: 'Turnbuckle' };
---
<Base title="Your account" noindex description="Sign in to rate matches and join the conversation.">
  <Crumbs trail={[['Your account']]} />
  <section class="section wrap">
    <div id="signedOut" hidden class="panel account-signin">
      <p class="eyebrow">Members</p>
      <h1>Join the <em style="font-style:normal;color:var(--gold)">card</em></h1>
      <p class="lede">Sign in to rate matches alongside us and Meltzer, build a profile, and (soon) join the forum.</p>
      <a class="google-btn" id="googleBtn" href="/api/auth/google">
        <svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        Sign in with Google
      </a>
      <p class="desk-hint" id="googleOff" hidden>Member sign-in isn't switched on yet. Check back soon.</p>
      <p class="desk-hint">We only ask Google for your email address, which stays private. Your public name is a handle you choose. See the <a href="/privacy/">privacy page</a>. You must be 13 or older to join.</p>
    </div>

    <div id="signedIn" hidden>
      <div class="desk-top">
        <div><p class="eyebrow">Your account</p><h1 id="acctName">Your profile</h1></div>
        <div class="btn-row" style="margin:0"><a class="btn ghost" id="viewProfile" href="#">View public profile</a><button class="btn ghost" type="button" id="signOut">Sign out</button></div>
      </div>
      <p class="desk-msg ok" id="welcome" hidden>Welcome to The Workrate Report! Pick a handle and an avatar to get started.</p>
      <form id="profileForm" class="desk-form" novalidate>
        <div class="panel">
          <p class="eyebrow">Identity</p>
          <div class="fields">
            <label class="field">Handle (your profile address)<input name="handle" required maxlength="24" autocomplete="off" /></label>
            <label class="field">Display name<input name="display_name" maxlength="40" /></label>
            <fieldset class="field wide"><legend>Avatar</legend>
              <div class="avatar-pick">{avatars.map((a) => <label><input type="radio" name="avatar" value={a} /><img src={`/avatars/${a}.svg`} alt={labels[a]} width="64" height="64" /></label>)}</div>
            </fieldset>
            <label class="field wide">About you<textarea name="bio" rows="4" maxlength="500" placeholder="Watching since the Superdome days…"></textarea></label>
          </div>
        </div>
        <div class="panel">
          <p class="eyebrow">Wrestling</p>
          <div class="fields">
            <label class="field">Watching since (year)<input name="watching_since" type="number" min="1940" max="2100" inputmode="numeric" /></label>
            <label class="field">Favorite era<input name="favorite_era" maxlength="40" placeholder="Attitude Era" /></label>
            <label class="field">Favorite promotion<input name="favorite_promotion" maxlength="60" placeholder="WCW" /></label>
            <label class="field">Favorite wrestler<input name="favorite_wrestler" maxlength="60" placeholder="Ricky Steamboat" /></label>
          </div>
        </div>
        <div class="panel">
          <p class="eyebrow">Privacy</p>
          <div class="checks">
            <label class="check"><input type="radio" name="visibility" value="public" /> Public: anyone can see my profile</label>
            <label class="check"><input type="radio" name="visibility" value="members" /> Members only</label>
            <label class="check"><input type="radio" name="visibility" value="private" /> Private: only my name and avatar</label>
          </div>
        </div>
        <div class="desk-actions"><p class="desk-msg" id="profileMsg" role="status" aria-live="polite"></p><button class="btn" type="submit">Save profile</button></div>
      </form>
    </div>
  </section>
  <script is:inline slot="scripts" src={`/js/account.js?v=${v}`} defer></script>
</Base>
